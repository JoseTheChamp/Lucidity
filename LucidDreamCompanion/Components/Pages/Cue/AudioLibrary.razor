@page "/cues/audio"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using LucidDreamCompanion.Data
@inject IDbContextFactory<LucidDbContext> DbFactory
@inject IAudioService Audio
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/cues")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Cues</span>
            <h1 style="font-size:22px">Audio library</h1>
        </div>
        <button class="btn btn-ghost" @onclick="StopAll" title="Stop all" disabled="@(!_playing)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="@(_playing ? "var(--warn)" : "var(--text-quat)")" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
        </button>
    </header>

    <div class="settings-list">
        <div style="display:flex;gap:10px">
            <button class="btn btn-primary" style="flex:1" @onclick="Import">Import file</button>
            <button class="btn @(_recording ? "btn-warn" : "")" style="flex:1" @onclick="ToggleRecord">
                @(_recording ? $"Stop ({_recordSeconds}s)" : "Record")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="card" style="border-color:rgba(248,113,113,0.35);background:rgba(248,113,113,0.06)">
                <div style="color:var(--warn);font-size:13px">@_error</div>
            </div>
        }

        @foreach (var group in _groups)
        {
            <div>
                <div class="month-header">
                    <span class="label-meta">@group.Label</span>
                    <div class="rule"></div>
                    <span class="count">@group.Items.Count</span>
                </div>
                @if (group.Items.Count == 0)
                {
                    <div style="color:var(--text-ter);font-size:13px;padding:8px 14px">Nothing yet.</div>
                }
                else
                {
                    <div style="display:flex;flex-direction:column;gap:8px">
                        @foreach (var a in group.Items)
                        {
                            <div class="tag-row">
                                @if (_editingId == a.Id)
                                {
                                    <input class="input" style="flex:1" @bind="_editName"
                                           @bind:event="oninput" @onkeydown="e => OnRenameKey(e, a)" />
                                    <button class="btn btn-primary" style="padding:6px 12px" @onclick="() => SaveRename(a)">Save</button>
                                    <button class="btn btn-ghost" style="padding:6px 12px" @onclick="() => _editingId = null">Cancel</button>
                                }
                                else
                                {
                                    <div style="flex:1;min-width:0">
                                        <div style="font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@a.DisplayName</div>
                                        <div class="mono" style="font-size:11px;color:var(--text-ter);margin-top:2px">@FormatDuration(a.DurationMs)</div>
                                    </div>
                                    <button class="btn btn-ghost" style="padding:8px 10px" @onclick="() => Play(a)" aria-label="Play">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--accent)" stroke="none"><path d="M8 5v14l11-7z"/></svg>
                                    </button>
                                    @if (a.Source != AudioAssetSource.Bundled)
                                    {
                                        <button class="btn btn-ghost" style="padding:8px 10px" @onclick="() => StartRename(a)" aria-label="Rename">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-sec)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        </button>
                                        <button class="btn btn-ghost" style="padding:8px 10px" @onclick="() => Delete(a)" aria-label="Delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14"/></svg>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private record Group(string Label, List<AudioAsset> Items);

    private List<Group> _groups = new();
    private bool _playing;
    private bool _recording;
    private string? _error;
    private int _recordSeconds;
    private int? _editingId;
    private string _editName = "";
    private CancellationTokenSource? _recordCts;
    private ConfirmDialog? _confirm;

    protected override async Task OnInitializedAsync()
    {
        Audio.PlaybackFinished += OnFinished;
        await Reload();
    }

    private async Task Reload()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.AudioAssets.AsNoTracking().OrderBy(a => a.Source).ThenBy(a => a.DisplayName).ToListAsync();
        _groups = new()
        {
            new Group("Bundled", all.Where(a => a.Source == AudioAssetSource.Bundled).ToList()),
            new Group("My recordings", all.Where(a => a.Source == AudioAssetSource.UserRecording).ToList()),
            new Group("Imported", all.Where(a => a.Source == AudioAssetSource.ImportedFile).ToList()),
        };
        StateHasChanged();
    }

    private async Task Play(AudioAsset a)
    {
        await Audio.StopAllAsync();
        var h = await Audio.PlayAsync(a, new AudioPlaybackOptions
        {
            VolumePercent = 70,
            FadeInSeconds = 0,
            LoopCount = 1,
        });
        _playing = h > 0;
        _error = h > 0 ? null : $"Couldn't play \"{a.DisplayName}\" — {Audio.LastError ?? "unknown error"}";
    }

    private async Task StopAll()
    {
        await Audio.StopAllAsync();
        _playing = false;
    }

    private void OnFinished(object? sender, PlaybackEventArgs e)
    {
        InvokeAsync(() => { _playing = false; StateHasChanged(); });
    }

    private async Task Import()
    {
        var a = await Audio.ImportFileAsync();
        if (a is not null) await Reload();
    }

    private async Task ToggleRecord()
    {
        if (_recording)
        {
            _recordCts?.Cancel();
            await Audio.StopRecordingAsync();
            _recording = false;
            await Reload();
            return;
        }
        if (!await Audio.RequestMicrophonePermissionAsync()) return;
        _recordSeconds = 0;
        _recording = true;
        _recordCts = new CancellationTokenSource();
        _ = Audio.RecordAsync(TimeSpan.FromSeconds(60));
        _ = TickRecording(_recordCts.Token);
    }

    private async Task TickRecording(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && _recordSeconds < 60)
            {
                await Task.Delay(1000, ct);
                _recordSeconds++;
                await InvokeAsync(StateHasChanged);
            }
            if (!ct.IsCancellationRequested && _recordSeconds >= 60)
            {
                await Audio.StopRecordingAsync();
                _recording = false;
                await Reload();
            }
        }
        catch (TaskCanceledException) { }
    }

    private void StartRename(AudioAsset a)
    {
        _editingId = a.Id;
        _editName = a.DisplayName;
    }

    private async Task SaveRename(AudioAsset a)
    {
        if (!string.IsNullOrWhiteSpace(_editName))
        {
            await Audio.RenameAssetAsync(a.Id, _editName);
        }
        _editingId = null;
        await Reload();
    }

    private async Task OnRenameKey(KeyboardEventArgs e, AudioAsset a)
    {
        if (e.Key == "Enter") await SaveRename(a);
        else if (e.Key == "Escape") _editingId = null;
    }

    private async Task Delete(AudioAsset a)
    {
        if (_confirm is null) return;
        var ok = await _confirm.ShowAsync(
            "Delete this audio?",
            $"\"{a.DisplayName}\" will be permanently removed from the library.",
            "Delete");
        if (!ok) return;
        await Audio.DeleteAssetAsync(a.Id);
        await Reload();
    }

    private static string FormatDuration(int ms)
    {
        if (ms <= 0) return "—";
        var t = TimeSpan.FromMilliseconds(ms);
        return t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes}:{t.Seconds:D2}" : $"{t.TotalSeconds:0.0}s";
    }

    public void Dispose()
    {
        Audio.PlaybackFinished -= OnFinished;
        _recordCts?.Cancel();
        _ = Audio.StopAllAsync();
    }
}
