@page "/journal/entry/{Id:int}"
@inject IDreamJournalService Journal
@inject IStatsService Stats
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/journal")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1"></div>
        <button class="btn btn-ghost" style="padding:10px" @onclick="Delete" aria-label="Delete dream">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14"/></svg>
        </button>
        <button class="btn" @onclick="Edit">Edit</button>
    </header>

    @if (_entry is null)
    {
        <div class="empty"><div class="title">Not found</div></div>
    }
    else
    {
        <div class="detail-meta">
            <LucidityEye Level="_entry.Lucidity" Size="22" />
            <span class="mono">@_entry.DreamDate.ToString("ddd · MMM d, yyyy").ToUpperInvariant()</span>
            @if (_entry.SleepQuality.HasValue)
            {
                <span class="mono" style="margin-left:auto">@_entry.SleepQuality.Value / 5 ★</span>
            }
        </div>
        <div class="editor">
            @if (_isFirstLucid)
            {
                <div class="first-lucid-badge">
                    <span style="font-size:18px">🌙</span>
                    <div>
                        <div style="font-size:13px;font-weight:600;color:var(--lucid)">First Lucid Dream</div>
                        <div style="font-size:11.5px;color:var(--text-sec)">The first of many. This one's a milestone.</div>
                    </div>
                </div>
            }
            <h1 style="margin:0;font-size:24px;letter-spacing:-0.3px">@(string.IsNullOrWhiteSpace(_entry.Title) ? "(untitled)" : _entry.Title)</h1>
            <div style="white-space:pre-wrap;font-size:15px;line-height:1.6;color:var(--text-pri)">@_entry.Body</div>
            @if (_entry.Tags.Count > 0)
            {
                <div class="picker-row">
                    @foreach (var t in _entry.Tags)
                    {
                        <TagChip Tag="t" />
                    }
                </div>
            }
        </div>
    }
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter] public int Id { get; set; }
    private DreamEntry? _entry;
    private bool _isFirstLucid;
    private ConfirmDialog? _confirm;

    protected override async Task OnParametersSetAsync()
    {
        _entry = await Journal.GetAsync(Id);
        if (_entry is { Lucidity: >= LucidityLevel.BriefLucidity })
        {
            var firstId = await Stats.GetFirstLucidEntryIdAsync();
            _isFirstLucid = firstId == _entry.Id;
        }
        else
        {
            _isFirstLucid = false;
        }
    }

    private void Edit() => Nav.NavigateTo($"/journal/edit/{Id}");

    private async Task Delete()
    {
        if (_entry is null || _confirm is null) return;
        var title = string.IsNullOrWhiteSpace(_entry.Title)
            ? (string.IsNullOrWhiteSpace(_entry.Body) ? "this dream" : "this dream")
            : $"\"{_entry.Title}\"";
        var ok = await _confirm.ShowAsync(
            "Delete this dream?",
            $"{title} from {_entry.DreamDate:MMM d, yyyy} will be permanently removed.",
            "Delete");
        if (!ok) return;
        await Journal.DeleteAsync(_entry.Id);
        Nav.NavigateTo("/journal");
    }
}
