@page "/settings/tags"
@implements IDisposable
@inject ITagService TagService
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/settings")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Settings</span>
            <h1 style="font-size:22px">Tags</h1>
        </div>
    </header>

    <div class="settings-list">
        <div class="field">
            <span class="field-label">New tag</span>
            <div style="display:flex;gap:8px;align-items:center">
                <input class="input" placeholder="name" @bind="_newName" @bind:event="oninput" />
                <input type="color" value="@_newColor" @oninput="e => _newColor = e.Value?.ToString() ?? _newColor"
                       style="width:42px;height:38px;border:1px solid var(--border);border-radius:8px;background:transparent" />
                <button class="btn btn-primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(_newName)">Add</button>
            </div>
        </div>

        @foreach (var t in _tags)
        {
            <div class="tag-row">
                <span class="swatch" style="background:@t.ColorHex"></span>
                @if (_editing == t.Id)
                {
                    <input class="input" style="flex:1" @bind="_editName" />
                    <input type="color" value="@_editColor" @oninput="e => _editColor = e.Value?.ToString() ?? _editColor"
                           style="width:36px;height:32px;border:1px solid var(--border);border-radius:8px;background:transparent" />
                    <button class="btn btn-primary" style="padding:6px 12px" @onclick="() => SaveEdit(t)">Save</button>
                    <button class="btn btn-ghost" style="padding:6px 12px" @onclick="() => _editing = null">Cancel</button>
                }
                else
                {
                    <span class="name">@t.Name @if (t.IsBuiltIn) { <span class="pill">built-in</span> }</span>
                    <button class="btn btn-ghost" style="padding:6px 10px" @onclick="() => StartEdit(t)" aria-label="Edit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-sec)" stroke-width="1.6" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </button>
                    <button class="btn btn-ghost" style="padding:6px 10px" @onclick="() => Delete(t)" aria-label="Delete">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14"/></svg>
                    </button>
                }
            </div>
        }
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private List<Tag> _tags = new();
    private ConfirmDialog? _confirm;
    private string _newName = "";
    private string _newColor = "#6B8AFF";
    private int? _editing;
    private string _editName = "";
    private string _editColor = "#6B8AFF";

    protected override async Task OnInitializedAsync()
    {
        TagService.Changed += OnChanged;
        await Reload();
    }

    private async void OnChanged() => await InvokeAsync(async () => { await Reload(); StateHasChanged(); });

    private async Task Reload() => _tags = (await TagService.ListAsync()).ToList();

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await TagService.CreateAsync(_newName, _newColor);
        _newName = "";
    }

    private void StartEdit(Tag t)
    {
        _editing = t.Id;
        _editName = t.Name;
        _editColor = t.ColorHex;
    }

    private async Task SaveEdit(Tag t)
    {
        await TagService.UpdateAsync(t.Id, _editName, _editColor);
        _editing = null;
    }

    private async Task Delete(Tag t)
    {
        if (_confirm is null) return;
        var uses = await TagService.CountUsageAsync(t.Id);
        var msg = uses > 0
            ? $"\"{t.Name}\" is used on {uses} {(uses == 1 ? "entry" : "entries")}. Deleting removes the tag from those entries but keeps the entries themselves."
            : $"Delete the \"{t.Name}\" tag?";
        var ok = await _confirm.ShowAsync("Delete tag?", msg, "Delete");
        if (!ok) return;
        await TagService.DeleteAsync(t.Id);
    }

    public void Dispose() => TagService.Changed -= OnChanged;
}
