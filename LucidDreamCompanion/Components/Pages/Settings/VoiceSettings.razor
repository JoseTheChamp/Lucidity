@page "/settings/voice"
@inject IAppSettingsService SettingsService
@inject ISpeechToTextService Speech
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/settings")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Settings</span>
            <h1 style="font-size:22px">Voice journaling</h1>
        </div>
    </header>

    <div class="settings-list">
        @if (!Speech.IsSupported)
        {
            <div class="card" style="border-color:rgba(248,113,113,0.35);background:rgba(248,113,113,0.06)">
                <div style="color:var(--warn);font-size:13px">No speech recognizer found on this device. Voice input is unavailable.</div>
            </div>
        }

        <div class="field">
            <span class="field-label">Recognition language</span>
            <select class="input" @bind="_locale">
                <option value="">Device default</option>
                <option value="en-US">English (US)</option>
                <option value="en-GB">English (UK)</option>
                <option value="cs-CZ">Čeština</option>
            </select>
            <div style="font-size:11.5px;color:var(--text-ter);margin-top:8px">
                Used when you dictate a dream with the mic button in the editor.
            </div>
        </div>

        <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="label-meta" style="text-align:center">@_status</div>
        }
    </div>
</div>

@code {
    private string _locale = "";
    private bool _busy;
    private string _status = "";

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsService.GetAsync();
        _locale = s.SpeechLocale;
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            var s = await SettingsService.GetAsync();
            s.SpeechLocale = _locale;
            await SettingsService.SaveAsync(s);
            _status = "Saved";
        }
        finally { _busy = false; }
    }
}
