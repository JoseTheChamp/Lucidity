@page "/sleep"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using LucidDreamCompanion.Data
@inject ISleepSessionService Sessions
@inject ICueProfileService Profiles
@inject ICueSchedulerService Scheduler
@inject IDreamJournalService Journal
@inject IDbContextFactory<LucidDbContext> DbFactory
@inject NavigationManager Nav

@if (_active is not null && !_ending)
{
    <!-- ─── Active session — ambient screen ─────────────────────── -->
    <div class="session-ambient screen-enter">
        <StarField Count="60" />
        <div class="session-aura"></div>

        <div class="session-content">
            <!-- Top bar -->
            <div style="display:flex;align-items:center;gap:10px">
                <button class="btn btn-ghost" style="padding:8px;margin-left:-8px;color:var(--text-sec)"
                        @onclick='() => Nav.NavigateTo("/")' aria-label="Back to home">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <span class="session-dot"></span>
                <span class="mono" style="font-size:11px;color:var(--text-sec);letter-spacing:0.8px;text-transform:uppercase">
                    Monitoring@(string.IsNullOrEmpty(_profileName) ? "" : " · " + _profileName)
                </span>
            </div>

            <!-- Center: elapsed -->
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-bottom:60px">
                <div class="label-meta" style="margin-bottom:14px;text-align:center">
                    Sleeping since @_active.StartedAt.ToLocalTime().ToString("HH:mm")
                </div>
                <div class="mono tabular session-timer">
                    @Hh:@Mm<span class="session-secs">:@Ss</span>
                </div>
                <div style="margin-top:18px;display:flex;align-items:center;gap:8px;color:var(--text-sec)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-sec)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    <span class="mono" style="font-size:12px;letter-spacing:0.5px">elapsed</span>
                </div>
            </div>

            <!-- Bottom: next cue + timeline + end -->
            <div style="display:flex;flex-direction:column;gap:12px">
                @if (_nextCue is { } next)
                {
                    <div class="next-cue-card">
                        <div class="next-cue-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0 4 3 4 0"/></svg>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div class="label-meta">Next cue</div>
                            <div style="margin-top:3px;font-size:14px;font-weight:500;color:var(--text-pri)">@next.CueLabel</div>
                        </div>
                        <div style="text-align:right">
                            <div class="mono tabular" style="font-size:18px;color:var(--accent);letter-spacing:-0.5px">@Remaining(next)</div>
                            <div class="mono" style="font-size:10px;color:var(--text-ter);letter-spacing:0.5px;text-transform:uppercase;margin-top:2px">remaining</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="padding:14px 16px;border-radius:14px;background:rgba(19,24,41,0.6);border:1px solid var(--border);text-align:center;color:var(--text-sec);font-size:13px">
                        @(_sessionLogs.Count == 0 ? "No cues scheduled — rest easy." : "All cues fired. Sleep well.")
                    </div>
                }

                <div style="padding:8px 4px">
                    <div class="cue-timeline">
                        <div class="cue-track"></div>
                        <div class="cue-progress" style="width:@(F(NowPct))%"></div>
                        <div class="cue-now" style="left:@(F(NowPct))%"></div>
                        @foreach (var log in _sessionLogs)
                        {
                            var fired = log.Status == CueLogStatus.Fired || log.FiredAt is not null;
                            <div class="cue-tick @(fired ? "fired" : "")" style="left:@(F(CuePct(log)))%" title="@log.CueLabel"></div>
                        }
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-top:4px">
                        <span class="mono" style="font-size:10px;color:var(--text-ter);letter-spacing:0.5px">NOW</span>
                        <span class="mono" style="font-size:10px;color:var(--text-ter);letter-spacing:0.5px">@_sessionLogs.Count CUES SCHEDULED</span>
                    </div>
                </div>

                <button class="btn" style="padding:14px 18px;border-radius:14px;background:rgba(248,113,113,0.06);border-color:rgba(248,113,113,0.25);color:var(--warn)"
                        @onclick="BeginEnd">
                    End sleep session
                </button>
            </div>
        </div>
    </div>
}
else
{
    <!-- ─── Idle / ending — normal layout ───────────────────────── -->
    <div class="screen screen-enter">
        <header class="appbar">
            <div>
                <span class="subtitle">Sleep</span>
                <h1>Tonight</h1>
            </div>
            <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/sleep/history")' aria-label="Session history">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-sec)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 3"/></svg>
            </button>
        </header>

        <div style="padding:0 var(--pad-x) 24px;display:flex;flex-direction:column;gap:var(--gap)">
            @if (_ending && _active is not null)
            {
                <div class="card">
                    <div style="font-size:17px;font-weight:500;margin-bottom:4px">How did you sleep?</div>
                    <div style="font-size:12.5px;color:var(--text-sec);margin-bottom:14px">Session ran @Hh:@Mm:@Ss.</div>

                    <div class="field">
                        <span class="field-label">Sleep quality</span>
                        <div class="stars">
                            @for (int s = 1; s <= 5; s++)
                            {
                                var star = s;
                                <button class="@(_quality.HasValue && star <= _quality ? "on" : "")" @onclick="() => _quality = star" aria-label="@star stars">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="@(_quality.HasValue && star <= _quality ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2l3.1 6.3L22 9.3l-5 4.9 1.2 6.9L12 17.8 5.8 21.1 7 14.2l-5-4.9 6.9-1z"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="field" style="margin-top:12px">
                        <span class="field-label">Notes (optional)</span>
                        <textarea class="input-bare" style="min-height:70px" placeholder="Woke a few times, vivid near morning…" @bind="_notes"></textarea>
                    </div>

                    <div style="display:flex;gap:10px;margin-top:16px">
                        <button class="btn" style="flex:1" @onclick="EndOnly" disabled="@_busy">End session</button>
                        <button class="btn btn-primary" style="flex:1" @onclick="EndAndLog" disabled="@_busy">End &amp; log dreams</button>
                    </div>
                </div>
            }
            else
            {
                <div class="card" style="text-align:center;padding:28px 18px">
                    <div style="display:inline-flex;padding:18px;border-radius:50%;background:var(--accent-soft);margin-bottom:14px">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    </div>
                    <div style="font-size:17px;font-weight:500;margin-bottom:6px">Ready to sleep</div>
                    <div style="font-size:13px;color:var(--text-sec);line-height:1.5;margin-bottom:18px">
                        Start a session to track your night. Pick a cue profile and its cues arm from this moment.
                    </div>

                    <div class="field" style="text-align:left;margin-bottom:14px">
                        <span class="field-label">Cue profile</span>
                        <select class="input" @bind="_selectedProfileId">
                            <option value="0">No cues tonight</option>
                            @foreach (var p in _profiles)
                            {
                                <option value="@p.Id">@p.Name (@p.Cues.Count cues)</option>
                            }
                        </select>
                    </div>

                    <button class="btn btn-primary" style="width:100%;padding:16px" @onclick="StartSleep" disabled="@_busy">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0E1A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        Start Sleep
                    </button>
                </div>
            }

            @if (_lastSessions.Count > 0)
            {
                <div>
                    <div class="month-header">
                        <span class="label-meta">Recent nights</span>
                        <div class="rule"></div>
                        <button class="btn btn-ghost" style="padding:2px 6px;font-size:11px;color:var(--text-sec)" @onclick='() => Nav.NavigateTo("/sleep/history")'>All →</button>
                    </div>
                    @foreach (var s in _lastSessions.Take(3))
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:rgba(26,32,56,0.35);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer"
                             @onclick="() => OpenSession(s.Id)">
                            <div style="flex:1">
                                <div style="font-size:14px;font-weight:500">@s.StartedAt.ToLocalTime().ToString("ddd, MMM d")</div>
                                <div class="mono" style="font-size:11px;color:var(--text-ter);margin-top:2px">@DurationOf(s)</div>
                            </div>
                            @if (s.Quality.HasValue)
                            {
                                <span class="mono" style="font-size:12px;color:var(--text-sec)">@s.Quality / 5 ★</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private SleepSession? _active;
    private List<CueProfile> _profiles = new();
    private List<SleepSession> _lastSessions = new();
    private List<ScheduledCueLog> _sessionLogs = new();
    private ScheduledCueLog? _nextCue;
    private string _profileName = "";
    private int _selectedProfileId;
    private bool _ending;
    private bool _busy;
    private int? _quality;
    private string _notes = "";
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCts;

    private TimeSpan Elapsed => _active is null
        ? TimeSpan.Zero
        : (DateTime.UtcNow - _active.StartedAt is var s && s < TimeSpan.Zero ? TimeSpan.Zero : s);

    private string Hh => ((int)Elapsed.TotalHours).ToString("D2");
    private string Mm => Elapsed.Minutes.ToString("D2");
    private string Ss => Elapsed.Seconds.ToString("D2");

    // Timeline span: session start → last cue + 30 min buffer.
    private double TotalSpanSec
    {
        get
        {
            if (_active is null || _sessionLogs.Count == 0) return 3600;
            var last = _sessionLogs.Max(l => l.ScheduledFor);
            var span = (last - _active.StartedAt).TotalSeconds + 1800;
            return Math.Max(span, 600);
        }
    }

    private double NowPct => Math.Clamp(Elapsed.TotalSeconds / TotalSpanSec * 100, 0, 100);

    private double CuePct(ScheduledCueLog log)
    {
        if (_active is null) return 0;
        var at = (log.ScheduledFor - _active.StartedAt).TotalSeconds;
        return Math.Clamp(at / TotalSpanSec * 100, 0, 100);
    }

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string Remaining(ScheduledCueLog log)
    {
        var rem = log.ScheduledFor - DateTime.UtcNow;
        if (rem < TimeSpan.Zero) rem = TimeSpan.Zero;
        var h = (int)rem.TotalHours;
        if (h > 0) return $"{h}h {rem.Minutes}m";
        if (rem.Minutes > 0) return $"{rem.Minutes}m {rem.Seconds:D2}s";
        return $"{rem.Seconds}s";
    }

    protected override async Task OnInitializedAsync()
    {
        Sessions.Changed += OnChanged;
        Scheduler.ActiveProfileChanged += OnChanged;
        await Reload();
    }

    private async void OnChanged() => await InvokeAsync(async () => { await Reload(); StateHasChanged(); });

    private async Task Reload()
    {
        _active = await Sessions.GetActiveAsync();
        _profiles = (await Profiles.ListAsync()).ToList();
        _lastSessions = (await Sessions.ListAsync()).Where(s => s.EndedAt != null).ToList();
        var activeProfileId = await Scheduler.GetActiveProfileIdAsync();
        if (_selectedProfileId == 0 && activeProfileId is { } ap) _selectedProfileId = ap;

        if (_active is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _sessionLogs = await db.ScheduledCueLogs.AsNoTracking()
                .Where(l => l.SleepSessionId == _active.Id)
                .OrderBy(l => l.ScheduledFor)
                .ToListAsync();
            _profileName = activeProfileId is { } pid
                ? (_profiles.FirstOrDefault(p => p.Id == pid)?.Name ?? "")
                : "";
        }
        else
        {
            _sessionLogs = new();
            _profileName = "";
        }
        RecomputeNextCue();
        EnsureTimer();
    }

    private void RecomputeNextCue()
    {
        var now = DateTime.UtcNow;
        _nextCue = _sessionLogs
            .Where(l => l.ScheduledFor > now && l.Status == CueLogStatus.Scheduled)
            .OrderBy(l => l.ScheduledFor)
            .FirstOrDefault();
    }

    private void EnsureTimer()
    {
        var shouldRun = _active is not null;
        if (shouldRun && _timer is null)
        {
            _timerCts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = TickLoop(_timerCts.Token);
        }
        else if (!shouldRun && _timer is not null)
        {
            StopTimer();
        }
    }

    private async Task TickLoop(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                RecomputeNextCue();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void StopTimer()
    {
        _timerCts?.Cancel();
        _timer?.Dispose();
        _timer = null;
        _timerCts = null;
    }

    private async Task StartSleep()
    {
        _busy = true;
        try
        {
            int? profileId = _selectedProfileId == 0 ? null : _selectedProfileId;
            await Sessions.StartAsync(profileId);
        }
        finally { _busy = false; }
    }

    private void BeginEnd()
    {
        _ending = true;
        _quality = null;
        _notes = "";
    }

    private async Task EndOnly()
    {
        if (_active is null) return;
        _busy = true;
        try
        {
            await Sessions.EndAsync(_active.Id, _quality, _notes);
            _ending = false;
        }
        finally { _busy = false; }
    }

    private async Task EndAndLog()
    {
        if (_active is null) return;
        _busy = true;
        try
        {
            await Sessions.EndAsync(_active.Id, _quality, _notes);
            _ending = false;
            var entry = await Journal.CreateAsync();
            Nav.NavigateTo($"/journal/edit/{entry.Id}?source=session");
        }
        finally { _busy = false; }
    }

    private void OpenSession(int id) => Nav.NavigateTo($"/sleep/history/{id}");

    private static string DurationOf(SleepSession s)
    {
        if (s.EndedAt is null) return "in progress";
        var d = s.EndedAt.Value - s.StartedAt;
        return $"{(int)d.TotalHours}h {d.Minutes:D2}m";
    }

    public void Dispose()
    {
        Sessions.Changed -= OnChanged;
        Scheduler.ActiveProfileChanged -= OnChanged;
        StopTimer();
    }
}
