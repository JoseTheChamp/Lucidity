@page "/sleep/history/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using LucidDreamCompanion.Data
@inject ISleepSessionService Sessions
@inject IDbContextFactory<LucidDbContext> DbFactory
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/sleep/history")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Sleep session</span>
            <h1 style="font-size:22px">@(_session is null ? "…" : _session.MainDate.ToString("MMM d"))</h1>
        </div>
        @if (_session is not null)
        {
            <button class="btn btn-ghost" style="padding:10px" @onclick="Delete" aria-label="Delete session">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14"/></svg>
            </button>
        }
    </header>

    @if (_session is null)
    {
        <div class="empty"><div class="title">Session not found</div></div>
    }
    else
    {
        <div style="padding:0 var(--pad-x) 24px;display:flex;flex-direction:column;gap:var(--gap)">
            <div class="card">
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
                    <div>
                        <div class="label-meta">Duration</div>
                        <div class="mono tabular" style="font-size:18px;margin-top:4px">@Duration()</div>
                    </div>
                    <div>
                        <div class="label-meta">Dreams</div>
                        <div class="mono tabular" style="font-size:18px;margin-top:4px">@_entries.Count</div>
                    </div>
                    <div>
                        <div class="label-meta">Lucid</div>
                        <div class="mono tabular" style="font-size:18px;margin-top:4px;color:var(--lucid)">@_lucidCount</div>
                    </div>
                </div>
                <div class="divider" style="margin:14px 0"></div>
                @if (_editingTimes)
                {
                    <div style="display:flex;flex-direction:column;gap:8px">
                        <label class="label-meta">Start
                            <input type="datetime-local" value="@_startDraft" @onchange="e => _startDraft = e.Value?.ToString() ?? _startDraft"
                                   style="margin-top:4px;width:100%;padding:6px 8px;font-size:13px" />
                        </label>
                        @if (_session.EndedAt is not null)
                        {
                            <label class="label-meta">End
                                <input type="datetime-local" value="@_endDraft" @onchange="e => _endDraft = e.Value?.ToString() ?? _endDraft"
                                       style="margin-top:4px;width:100%;padding:6px 8px;font-size:13px" />
                            </label>
                        }
                        <div style="display:flex;gap:8px;margin-top:4px">
                            <button class="btn btn-primary" style="padding:6px 14px;font-size:13px" @onclick="SaveTimes">Save times</button>
                            <button class="btn" style="padding:6px 14px;font-size:13px" @onclick="() => _editingTimes = false">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--text-sec)">
                        <span style="cursor:pointer" @onclick="EditTimes">
                            @_session.StartedAt.ToLocalTime().ToString("ddd MMM d · HH:mm") → @(_session.EndedAt?.ToLocalTime().ToString("HH:mm") ?? "—")
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--text-ter)" stroke-width="1.8" style="margin-left:4px;vertical-align:middle"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                        </span>
                        @if (_session.Quality.HasValue)
                        {
                            <span class="mono">@_session.Quality / 5 ★</span>
                        }
                    </div>
                }
                @if (_session.TechniqueProfile is not null)
                {
                    <div style="font-size:12px;color:var(--text-ter);margin-top:8px">Cue profile: @_session.TechniqueProfile.Name</div>
                }
            </div>

            <!-- Aim & notes — editable, voice or text -->
            <div class="card">
                <div class="label-meta" style="margin-bottom:8px">Night's aim</div>
                @if (_editingAim)
                {
                    <VoiceTextArea @bind-Value="_aimDraft"
                                   Placeholder="What did you intend for this night?" MinHeight="56" />
                    <div style="display:flex;gap:8px;margin-top:8px">
                        <button class="btn btn-primary" style="padding:6px 14px;font-size:13px" @onclick="SaveAim">Save</button>
                        <button class="btn" style="padding:6px 14px;font-size:13px" @onclick="() => _editingAim = false">Cancel</button>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_session.Aim))
                {
                    <div class="aim-readout" @onclick="EditAim">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--lavender)" stroke-width="1.7" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
                        <div class="aim-text">@_session.Aim</div>
                    </div>
                }
                else
                {
                    <button class="aim-chip" @onclick="EditAim">+ Add an aim</button>
                }

                <div class="divider" style="margin:14px 0"></div>

                <div class="label-meta" style="margin-bottom:8px">Notes</div>
                @if (_editingNotes)
                {
                    <VoiceTextArea @bind-Value="_notesDraft"
                                   Placeholder="How the night went…" MinHeight="70" />
                    <div style="display:flex;gap:8px;margin-top:8px">
                        <button class="btn btn-primary" style="padding:6px 14px;font-size:13px" @onclick="SaveNotes">Save</button>
                        <button class="btn" style="padding:6px 14px;font-size:13px" @onclick="() => _editingNotes = false">Cancel</button>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_session.Notes))
                {
                    <div style="font-size:13px;color:var(--text-pri);white-space:pre-wrap;cursor:pointer" @onclick="EditNotes">@_session.Notes</div>
                }
                else
                {
                    <button class="aim-chip" @onclick="EditNotes">+ Add a note</button>
                }
            </div>

            <div>
                <div class="month-header">
                    <span class="label-meta">Dreams</span>
                    <div class="rule"></div>
                    <span class="count">@_entries.Count</span>
                </div>
                @if (_entries.Count == 0)
                {
                    <div style="color:var(--text-ter);font-size:13px;padding:4px 4px 8px">No dreams logged for this night.</div>
                }
                else
                {
                    <div class="entry-group">
                        @foreach (var e in _entries)
                        {
                            <div class="entry-row" @onclick="() => OpenEntry(e.Id)">
                                <div class="gutter">
                                    <LucidityEye Level="e.Lucidity" Size="20" />
                                </div>
                                <div class="main">
                                    <div class="title">@(string.IsNullOrWhiteSpace(e.Title) ? "(untitled)" : e.Title)</div>
                                    <div class="body">@e.Body</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div>
                <div class="month-header">
                    <span class="label-meta">Cue log</span>
                    <div class="rule"></div>
                    <span class="count">@_cueLogs.Count(l => l.Status == CueLogStatus.Fired)/@_cueLogs.Count</span>
                </div>
                @if (_cueLogs.Count == 0)
                {
                    <div style="color:var(--text-ter);font-size:13px;padding:4px 4px 8px">No cues were armed for this session.</div>
                }
                else
                {
                    @foreach (var log in _cueLogs)
                    {
                        <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(26,32,56,0.35);border:1px solid var(--border);border-radius:10px;margin-bottom:8px">
                            <span style="width:8px;height:8px;border-radius:50%;background:@StatusColor(log.Status)"></span>
                            <span style="flex:1;font-size:13px">@log.CueLabel</span>
                            <span class="mono" style="font-size:11px;color:var(--text-ter)">@log.ScheduledFor.ToLocalTime().ToString("HH:mm")</span>
                            <span class="label-meta">@(log.Status ?? "—")</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter] public int Id { get; set; }

    private SleepSession? _session;
    private List<DreamEntry> _entries = new();
    private List<ScheduledCueLog> _cueLogs = new();
    private int _lucidCount;
    private ConfirmDialog? _confirm;
    private bool _editingAim;
    private bool _editingNotes;
    private bool _editingTimes;
    private string _aimDraft = "";
    private string _notesDraft = "";
    private string _startDraft = "";
    private string _endDraft = "";

    protected override async Task OnParametersSetAsync()
    {
        _session = await Sessions.GetAsync(Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        _entries = await db.DreamEntries.AsNoTracking()
            .Where(e => e.SleepSessionId == Id)
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();
        _lucidCount = _entries.Count(e => e.Lucidity >= LucidityLevel.BriefLucidity);
        _cueLogs = await db.ScheduledCueLogs.AsNoTracking()
            .Where(l => l.SleepSessionId == Id)
            .OrderBy(l => l.ScheduledFor)
            .ToListAsync();
    }

    private void OpenEntry(int id) => Nav.NavigateTo($"/journal/entry/{id}");

    private void EditAim()
    {
        _aimDraft = _session?.Aim ?? "";
        _editingAim = true;
    }

    private async Task SaveAim()
    {
        if (_session is null) return;
        await Sessions.SetAimAsync(_session.Id, _aimDraft);
        _session = await Sessions.GetAsync(Id);
        _editingAim = false;
    }

    private void EditTimes()
    {
        if (_session is null) return;
        _startDraft = _session.StartedAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
        _endDraft = _session.EndedAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? "";
        _editingTimes = true;
    }

    private async Task SaveTimes()
    {
        if (_session is null) return;
        if (!DateTime.TryParse(_startDraft, out var startLocal)) { _editingTimes = false; return; }
        DateTime? endUtc = null;
        if (_session.EndedAt is not null)
        {
            if (!DateTime.TryParse(_endDraft, out var endLocal)) { _editingTimes = false; return; }
            endUtc = endLocal.ToUniversalTime();
        }
        await Sessions.SetTimesAsync(_session.Id, startLocal.ToUniversalTime(), endUtc);
        _session = await Sessions.GetAsync(Id);
        _editingTimes = false;
    }

    private void EditNotes()
    {
        _notesDraft = _session?.Notes ?? "";
        _editingNotes = true;
    }

    private async Task SaveNotes()
    {
        if (_session is null) return;
        await Sessions.SetNotesAsync(_session.Id, _notesDraft);
        _session = await Sessions.GetAsync(Id);
        _editingNotes = false;
    }

    private async Task Delete()
    {
        if (_session is null || _confirm is null) return;
        var msg = _entries.Count > 0
            ? $"This {_session.MainDate:MMM d} session will be removed. Its {_entries.Count} linked dream(s) are kept — they'll just no longer be tied to a session."
            : $"This {_session.MainDate:MMM d} session will be permanently removed.";
        var ok = await _confirm.ShowAsync("Delete this session?", msg, "Delete");
        if (!ok) return;
        await Sessions.DeleteAsync(_session.Id);
        Nav.NavigateTo("/sleep/history");
    }

    private string Duration()
    {
        if (_session?.EndedAt is null) return "—";
        var d = _session.EndedAt.Value - _session.StartedAt;
        return $"{(int)d.TotalHours}h {d.Minutes:D2}m";
    }

    private static string StatusColor(string? status) => status switch
    {
        CueLogStatus.Fired => "var(--lucid)",
        CueLogStatus.Failed => "var(--warn)",
        CueLogStatus.Scheduled => "var(--accent)",
        _ => "var(--text-quat)",
    };
}
