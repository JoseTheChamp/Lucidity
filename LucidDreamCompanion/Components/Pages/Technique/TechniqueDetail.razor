@page "/techniques/{Key}"
@inject ITechniqueTemplateService Techniques
@inject ICueProfileService Profiles
@inject ICueSchedulerService Scheduler
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/techniques")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Technique</span>
            <h1 style="font-size:22px">@(_def?.Name ?? "…")</h1>
        </div>
    </header>

    @if (_def is null)
    {
        <div class="empty"><div class="title">Unknown technique</div></div>
    }
    else
    {
        <div style="padding:0 var(--pad-x) 24px;display:flex;flex-direction:column;gap:var(--gap)">
            <div class="card">
                <div class="mono" style="font-size:24px;color:var(--accent);letter-spacing:0.04em">@_def.Key</div>
                <div style="font-size:14px;color:var(--text-sec);margin-top:2px">@_def.Tagline</div>
                <div class="divider" style="margin:12px 0"></div>
                <div style="font-size:13.5px;line-height:1.6;color:var(--text-pri)">@_def.Overview</div>
            </div>

            <div class="card">
                <div class="label-meta" style="margin-bottom:12px">Step by step</div>
                <ol class="technique-steps">
                    @foreach (var step in _def.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
            </div>

            @if (_cueProfile is { Cues.Count: > 0 })
            {
                <div class="card">
                    <div class="label-meta" style="margin-bottom:10px">Cues</div>
                    @foreach (var c in _cueProfile.Cues.OrderBy(c => c.SortOrder))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-sec);padding:4px 0">
                            <span>@c.Label</span>
                            <span class="mono" style="font-size:11px;color:var(--text-ter)">@CueTiming(c)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card" style="border-color:rgba(167,139,250,0.3);background:rgba(167,139,250,0.06)">
                    <div style="font-size:13px;color:var(--lavender)">No audio cues — this is a purely mental technique. Pair it with your journal reminders.</div>
                </div>
            }

            @if (_def.PairedTags.Length > 0)
            {
                <div>
                    <div class="label-meta" style="margin-bottom:8px">Pairs well with</div>
                    <div class="picker-row">
                        @foreach (var tag in _def.PairedTags)
                        {
                            <span class="chip">@tag</span>
                        }
                    </div>
                </div>
            }

            <div class="divider" style="margin:4px 0"></div>

            @if (_isActive)
            {
                <button class="btn btn-warn" @onclick="Deactivate">Deactivate</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Activate">Activate tonight</button>
            }
            <button class="btn" @onclick="DuplicateToEdit">Duplicate as editable profile</button>
            @if (!string.IsNullOrEmpty(_status))
            {
                <div class="label-meta" style="text-align:center">@_status</div>
            }
        </div>
    }
</div>

<style>
.technique-steps {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.technique-steps li {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-pri);
}
.technique-steps li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
}
</style>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter] public string Key { get; set; } = "";

    private TechniqueDefinition? _def;
    private CueProfile? _cueProfile;
    private bool _isActive;
    private ConfirmDialog? _confirm;
    private string _status = "";

    protected override async Task OnParametersSetAsync()
    {
        _def = Techniques.GetDefinition(Key);
        if (_def is null) return;
        _cueProfile = await Techniques.GetProfileAsync(Key);
        var activeId = await Scheduler.GetActiveProfileIdAsync();
        _isActive = _cueProfile is not null && activeId == _cueProfile.Id;
    }

    private async Task Activate()
    {
        if (_confirm is null || _cueProfile is null) return;

        if (!Scheduler.ExactAlarmsAllowed)
        {
            var go = await _confirm.ShowAsync(
                "Allow exact alarms",
                "Android needs permission to fire cues at exact times. Open settings to allow it?",
                "Open settings", "Later", destructive: false);
            if (go) Scheduler.RequestExactAlarmPermission();
            return;
        }
        if (!Scheduler.BatteryOptimizationIgnored)
        {
            var go = await _confirm.ShowAsync(
                "Battery optimization",
                "To fire cues reliably overnight, exempt this app from battery optimization. Open settings?",
                "Open settings", "Skip", destructive: false);
            if (go)
            {
                Scheduler.RequestBatteryExemption();
                return;
            }
        }

        var confirm = await _confirm.ShowAsync(
            $"Activate {_def!.Name}?",
            _cueProfile.Cues.Count > 0
                ? $"{_def.Name}'s cues will arm from the moment you press Start Sleep, and the overnight monitor starts."
                : $"{_def.Name} has no audio cues — activating just marks it as tonight's technique. Your journal reminders still apply.",
            "Activate", destructive: false);
        if (!confirm) return;

        await Scheduler.ActivateProfileAsync(_cueProfile.Id, DateTime.UtcNow);
        _isActive = true;
        _status = $"{_def.Name} is active for tonight";
    }

    private async Task Deactivate()
    {
        await Scheduler.DeactivateAsync();
        _isActive = false;
        _status = "Deactivated";
    }

    private async Task DuplicateToEdit()
    {
        if (_cueProfile is null) return;
        var copy = await Profiles.DuplicateAsync(_cueProfile.Id);
        if (copy is not null)
        {
            Nav.NavigateTo($"/cues/profiles/{copy.Id}");
        }
    }

    private static string CueTiming(AudioCue c) => c.TriggerMode switch
    {
        CueTriggerMode.SleepRelative => c.OffsetFromSleepStart is { } o ? $"sleep +{(int)o.TotalHours}h{o.Minutes:D2}m" : "sleep-relative",
        CueTriggerMode.ClockBased => c.ClockTime is { } t ? t.ToString("HH:mm") : "clock",
        CueTriggerMode.Interval => "interval",
        _ => "—",
    };
}
