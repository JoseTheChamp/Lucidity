@page "/games/math"
@implements IDisposable
@inject NavigationManager Nav

<div class="screen screen-enter">
    <header class="appbar">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/sleep")' aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div style="flex:1">
            <span class="subtitle">Game</span>
            <h1 style="font-size:22px">Math</h1>
        </div>
        <button class="btn btn-ghost" style="padding:8px" @onclick="() => _showInfo = true" aria-label="How to play">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-sec)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01"/><path d="M11 12h1v4h1"/></svg>
        </button>
    </header>

    <div style="padding:0 var(--pad-x) 24px;display:flex;flex-direction:column;gap:var(--gap)">

        <!-- Score row -->
        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-ter);padding:0 4px">
            <span class="mono">✓ @_correct</span>
            <span class="mono">streak @_streak</span>
            <span class="mono">✗ @_wrong</span>
        </div>

        <!-- Timer bar -->
        <div class="math-timer">
            <div class="math-timer-fill" style="width:@TimerPct%;background:@TimerColor"></div>
        </div>

        <!-- Problem -->
        <div class="card" style="padding:28px 14px;text-align:center">
            <div class="mono tabular" style="font-size:36px;letter-spacing:1px">@ProblemText</div>
            <div class="mono tabular" style="margin-top:14px;font-size:28px;color:var(--accent);min-height:36px">
                @(string.IsNullOrEmpty(_input) ? "·" : _input)
            </div>
            @if (!string.IsNullOrEmpty(_feedback))
            {
                <div class="label-meta" style="margin-top:8px;color:@(_feedbackOk ? "var(--lucid)" : "var(--warn)")">@_feedback</div>
            }
            <div class="label-meta" style="margin-top:6px">
                range 0–@CurrentMax · @CurrentTimeMs/1000 s
            </div>
        </div>

        <!-- Number pad -->
        <div class="math-pad">
            @foreach (var key in new[] { "1","2","3","4","5","6","7","8","9","⌫","0","✓" })
            {
                var k = key;
                <button class="math-key @(k == "✓" ? "math-key-ok" : "")" @onclick="() => Tap(k)">@k</button>
            }
        </div>
    </div>
</div>

@if (_showInfo)
{
    <div class="game-info-backdrop" @onclick="() => _showInfo = false">
        <div class="game-info-card" @onclick:stopPropagation="true">
            <div style="font-size:16px;font-weight:600;margin-bottom:10px">How to play Math</div>
            <div style="font-size:13px;color:var(--text-sec);line-height:1.55">
                Solve each problem before the timer runs out. Operations alternate at random:
                <b>+</b>, <b>−</b>, <b>×</b>, <b>÷</b> (always whole-number answers). Tap the digits and
                <b>✓</b> to submit.
                <br /><br />
                Difficulty <b>adapts to you</b>: every correct answer makes the next round slightly
                tougher — alternating between <i>bigger numbers</i> and a <i>shorter timer</i>. A wrong
                or timed-out answer eases things back two steps. There's no end — see how high you can climb.
            </div>
            <button class="btn btn-primary" style="margin-top:16px;width:100%" @onclick="() => _showInfo = false">Got it</button>
        </div>
    </div>
}

<style>
.math-timer {
    height: 6px;
    background: rgba(255,255,255,0.04);
    border-radius: 3px;
    overflow: hidden;
}
.math-timer-fill {
    height: 100%;
}
.math-pad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}
.math-key {
    padding: 20px 0;
    background: rgba(26,32,56,0.55);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-pri);
    font-family: var(--font-mono);
    font-size: 22px;
    cursor: pointer;
}
.math-key:active { background: var(--accent-soft); }
.math-key-ok { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }

.game-info-backdrop {
    position: fixed; inset: 0;
    background: rgba(5, 8, 18, 0.78);
    display: flex; align-items: center; justify-content: center;
    padding: 20px; z-index: 1000;
}
.game-info-card {
    background: rgba(19,24,41,0.96);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px; max-width: 360px; width: 100%;
}
</style>

@code {
    private enum Op { Plus, Minus, Times, Divide }

    private Op _op;
    private int _a, _b, _answer;
    private string _input = "";
    private int _correct, _wrong, _streak;
    private string _feedback = "";
    private bool _feedbackOk;
    private bool _showInfo;

    // Adaptive difficulty: each correct answer increments either range-boost or speed-boost,
    // alternating. A wrong/timeout drops two boosts. Tunes "slightly harder up, decently easier down."
    private int _rangeBoosts;
    private int _speedBoosts;
    private bool _nextBoostIsSpeed;

    private int CurrentMax => 8 + _rangeBoosts * 2;
    private int CurrentTimeMs => Math.Max(2500, 12000 - _speedBoosts * 600);

    private int _timerMs;
    private double TimerPct => Math.Clamp(_timerMs * 100.0 / Math.Max(1, CurrentTimeMs), 0, 100);
    private string TimerColor => _timerMs > CurrentTimeMs * 0.4
        ? "var(--accent)"
        : _timerMs > CurrentTimeMs * 0.15 ? "#fbbf24" : "var(--warn)";

    private CancellationTokenSource? _cts;
    private readonly Random _rng = new();

    protected override void OnInitialized() => NextProblem();

    private string ProblemText => _op switch
    {
        Op.Plus => $"{_a} + {_b}",
        Op.Minus => $"{_a} − {_b}",
        Op.Times => $"{_a} × {_b}",
        Op.Divide => $"{_a} ÷ {_b}",
        _ => "",
    };

    private void NextProblem()
    {
        _op = (Op)_rng.Next(4);
        var max = CurrentMax;
        // × and ÷ become brutal fast; cap their operand range tighter than +/−.
        var mulMax = Math.Min(max, 5 + _rangeBoosts);
        switch (_op)
        {
            case Op.Plus:
                _a = _rng.Next(2, max + 1);
                _b = _rng.Next(2, max + 1);
                _answer = _a + _b;
                break;
            case Op.Minus:
                _a = _rng.Next(3, max + 1);
                _b = _rng.Next(1, _a);
                _answer = _a - _b;
                break;
            case Op.Times:
                _a = _rng.Next(2, mulMax + 1);
                _b = _rng.Next(2, mulMax + 1);
                _answer = _a * _b;
                break;
            case Op.Divide:
                var q = _rng.Next(2, mulMax + 1);
                _b = _rng.Next(2, mulMax + 1);
                _a = q * _b;
                _answer = q;
                break;
        }
        _input = "";
        StartTimer();
    }

    private void StartTimer()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _timerMs = CurrentTimeMs;
        _ = RunTimer(_cts.Token);
    }

    private async Task RunTimer(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));
            while (await timer.WaitForNextTickAsync(ct))
            {
                _timerMs -= 50;
                if (_timerMs <= 0)
                {
                    await InvokeAsync(Timeout);
                    return;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void Tap(string key)
    {
        if (key == "⌫")
        {
            if (_input.Length > 0) _input = _input[..^1];
        }
        else if (key == "✓")
        {
            Submit();
        }
        else if (_input.Length < 5)
        {
            _input += key;
        }
    }

    private void Submit()
    {
        if (string.IsNullOrEmpty(_input)) return;
        if (int.TryParse(_input, out var v) && v == _answer) Correct();
        else Wrong(_input);
    }

    private void Correct()
    {
        _cts?.Cancel();
        _correct++;
        _streak++;
        if (_nextBoostIsSpeed) _speedBoosts++;
        else _rangeBoosts++;
        _nextBoostIsSpeed = !_nextBoostIsSpeed;
        _feedback = "Correct";
        _feedbackOk = true;
        NextProblem();
    }

    private void Wrong(string? shown = null)
    {
        _cts?.Cancel();
        _wrong++;
        _streak = 0;
        // Drop two boosts to make the next round decently simpler — peel from whichever has more.
        for (var i = 0; i < 2; i++)
        {
            if (_rangeBoosts == 0 && _speedBoosts == 0) break;
            if (_rangeBoosts >= _speedBoosts && _rangeBoosts > 0) _rangeBoosts--;
            else if (_speedBoosts > 0) _speedBoosts--;
        }
        _feedback = $"Was {_answer}";
        _feedbackOk = false;
        NextProblem();
    }

    private void Timeout() => Wrong();

    public void Dispose() => _cts?.Cancel();
}
