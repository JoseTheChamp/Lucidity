@inject NavigationManager Nav
@implements IDisposable

<nav class="bottom-nav">
    @foreach (var item in Items)
    {
        <button class="nav-item @(IsActive(item) ? "active" : "")" @onclick="() => Go(item.Href)">
            @((MarkupString)item.SvgIcon)
            <span>@item.Label</span>
        </button>
    }
</nav>

@code {
    private record NavItem(string Label, string Href, string SvgIcon, string[] Roots);

    private static readonly NavItem[] Items = new[]
    {
        new NavItem("Journal", "/journal",
            "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M4 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4z'/><path d='M8 8h8M8 12h8M8 16h5'/></svg>",
            new [] { "/journal" }),
        new NavItem("Cues", "/cues",
            "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M2 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0 4 3 4 0'/></svg>",
            new [] { "/cues" }),
        new NavItem("Sleep", "/sleep",
            "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'/></svg>",
            new [] { "/sleep" }),
        new NavItem("Stats", "/stats",
            "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19V5M10 19v-9M16 19v-5M22 19H2'/></svg>",
            new [] { "/stats" }),
        new NavItem("Settings", "/settings",
            "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9c.4.6 1 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z'/></svg>",
            new [] { "/settings" }),
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLoc;
    }

    private void OnLoc(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsActive(NavItem item)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (path.Length == 0) path = "/journal"; // root maps to journal
        foreach (var root in item.Roots)
        {
            if (path == root) return true;
            if (path.StartsWith(root + "/", StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private void Go(string href) => Nav.NavigateTo(href);

    public void Dispose() => Nav.LocationChanged -= OnLoc;
}
