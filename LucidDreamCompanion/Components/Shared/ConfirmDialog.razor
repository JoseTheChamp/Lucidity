@if (_open)
{
    <div class="modal-scrim" @onclick="Cancel">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-title">@_title</div>
            <div class="modal-body">@_message</div>
            <div class="modal-actions">
                <button class="btn" @onclick="Cancel">@_cancelLabel</button>
                <button class="btn @(_destructive ? "btn-warn" : "btn-primary")" @onclick="Confirm">@_confirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private string _title = "";
    private string _message = "";
    private string _confirmLabel = "Confirm";
    private string _cancelLabel = "Cancel";
    private bool _destructive;
    private TaskCompletionSource<bool>? _tcs;

    public Task<bool> ShowAsync(string title, string message, string confirmLabel = "Delete", string cancelLabel = "Cancel", bool destructive = true)
    {
        _title = title;
        _message = message;
        _confirmLabel = confirmLabel;
        _cancelLabel = cancelLabel;
        _destructive = destructive;
        _open = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private void Confirm()
    {
        _open = false;
        _tcs?.TrySetResult(true);
        StateHasChanged();
    }

    private void Cancel()
    {
        _open = false;
        _tcs?.TrySetResult(false);
        StateHasChanged();
    }
}
