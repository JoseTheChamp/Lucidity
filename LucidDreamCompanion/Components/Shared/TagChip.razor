@using LucidDreamCompanion.Data.Entities

<span class="chip @(OnClick.HasDelegate ? "chip-clickable" : "")"
      style="@Style"
      @onclick="HandleClick">
    <span class="dot" style="background:@Tag.ColorHex"></span>
    @Tag.Name
</span>

@code {
    [Parameter, EditorRequired] public Tag Tag { get; set; } = null!;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string Style
    {
        get
        {
            var pad = Small ? "3px 8px" : "5px 10px";
            var fs = Small ? "11px" : "12px";
            var bg = Active ? $"{Tag.ColorHex}1A" : "rgba(255,255,255,0.03)";
            var color = Active ? Tag.ColorHex : "var(--text-sec)";
            var border = Active ? Tag.ColorHex : "var(--border-2)";
            return $"padding:{pad};font-size:{fs};background:{bg};color:{color};border-color:{border};";
        }
    }

    private Task HandleClick() => OnClick.HasDelegate ? OnClick.InvokeAsync() : Task.CompletedTask;
}
